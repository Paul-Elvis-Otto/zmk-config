#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

// Home row mods macro
/* #define _HRML(k1,k2,k3,k4) &ht LSHFT k1  &ht LALT k2  &ht LCTRL k3  &ht LGUI k4 */
/* #define _HRMR(k1,k2,k3,k4) &ht RGUI k1  &ht RCTRL k2  &ht RALT k3  &ht RSHFT k4 */
/* Removed the above because qmk.nvim would not work otherwise */
/ {
    behaviors {
        ht: hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <220>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <100>;
            bindings = <&kp>, <&kp>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <1 2>;
            then-layer = <5>;
        };
    };

    keymap {
        compatible = "zmk,keymap";
        default_layer {
            display-name = "Default Layer";
            bindings = <
//    ┌─────────┬──────┬──────┬──────┬──────┐   ┌──────┬──────┬──────┬──────┬─────────┐
//    │    Q    │  W   │  E   │  R   │  T   │   │  Y   │  U   │  I   │  O   │    P    │
//    ├─────────┼──────┼──────┼──────┼──────┤   ├──────┼──────┼──────┼──────┼─────────┤
//    │  lsft A │  S   │  D   │  F   │  G   │   │  H   │  J   │  K   │  L   │  rsft ; │
//    ├─────────┼──────┼──────┼──────┼──────┤   ├──────┼──────┼──────┼──────┼─────────┤
//    │   ⇧ Z   │  ⌥ X │  ⌃ C │  ⌘ V │  B   │   │  N   │  ⌘ M │  ⌃ , │  ⌥ . │   ⇧ /   │
//    └─────────┴──────┴──────┼──────┼──────┤   ├──────┼──────┼──────┴──────┴─────────┘
//                            │  2 ⇥ │  3 ⌫ │   │  4 ␣ │  1 ⏎ │
//                            └──────┴──────┘   └──────┴──────┘
  &kp Q          &kp W        &kp E         &kp R        &kp T            &kp Y         &kp U         &kp I             &kp O          &kp P
  &mt LSHIFT A   &kp S        &kp D         &kp F        &kp G            &kp H         &kp J         &kp K             &kp L          &mt RSHIFT SEMI
  &ht LSHFT Z    &ht LALT X   &ht LCTRL C   &ht LGUI V   &kp B            &kp N         &ht RGUI M    &ht RCTRL COMMA   &ht RALT DOT   &ht RSHFT FSLH
                                            &lt 2 TAB    &lt 3 BSPC       &lt 4 SPACE   &lt 1 ENTER
            >;
        };

        right_layer {
            display-name = "Right Layer";
            bindings = <
//    ┌───────┬───┬───┬─────┬─────┐   ┌──────┬──────┬──────┬──────┬──────┐
//    │  Esc  │ 1 │ 2 │  3  │     │   │ home │ pgdn │ pgup │ end  │  :   │
//    ├───────┼───┼───┼─────┼─────┤   ├──────┼──────┼──────┼──────┼──────┤
//    │  del  │ 4 │ 5 │  6  │     │   │ left │ down │  up  │ rght │ rsft │
//    ├───────┼───┼───┼─────┼─────┤   ├──────┼──────┼──────┼──────┼──────┤
//    │ capsw │ 7 │ 8 │  9  │  0  │   │      │      │      │      │      │
//    └───────┴───┴───┼─────┼─────┤   ├──────┼──────┼──────┴──────┴──────┘
//                    │     │ Esc │   │      │      │
//                    └─────┴─────┘   └──────┴──────┘
  &kp ESC      &kp N1   &kp N2   &kp N3   &trans        &kp HOME   &kp PG_DN   &kp PG_UP   &kp END     &kp COLON
  &kp DEL      &kp N4   &kp N5   &kp N6   &trans        &kp LEFT   &kp DOWN    &kp UP      &kp RIGHT   &kp RSHIFT
  &caps_word   &kp N7   &kp N8   &kp N9   &kp N0        &trans     &trans      &trans      &trans      &trans
                                 &trans   &kp ESC       &trans     &trans
            >;
        };

        left_layer {
            display-name = "Left Layer";
            bindings = <
//    ┌─────┬─────┬─────┬─────┬─────┐   ┌─────┬─────┬───┬───┬─────┐
//    │ Esc │  [  │  {  │  }  │     │   │  ^  │  (  │ ) │ ] │  ~  │
//    ├─────┼─────┼─────┼─────┼─────┤   ├─────┼─────┼───┼───┼─────┤
//    │  !  │  @  │  #  │  $  │  %  │   │  *  │  -  │ = │ \ │  `  │
//    ├─────┼─────┼─────┼─────┼─────┤   ├─────┼─────┼───┼───┼─────┤
//    │     │     │     │     │     │   │  &  │  _  │ + │ | │     │
//    └─────┴─────┴─────┼─────┼─────┤   ├─────┼─────┼───┴───┴─────┘
//                      │     │     │   │     │     │
//                      └─────┴─────┘   └─────┴─────┘
  &kp ESC    &kp LBKT   &kp LBRC   &kp RBRC   &trans          &kp CARET   &kp LPAR    &kp RPAR    &kp RBKT   &kp TILDE
  &kp EXCL   &kp AT     &kp HASH   &kp DLLR   &kp PRCNT       &kp ASTRK   &kp MINUS   &kp EQUAL   &kp BSLH   &kp GRAVE
  &trans     &trans     &trans     &trans     &trans          &kp AMPS    &kp UNDER   &kp PLUS    &kp PIPE   &trans
                                   &trans     &trans          &trans      &trans
            >;
        };
        sym_layer {
            display-name = "Sym Layer";
            bindings = <
//    ┌─────┬───┬───┬─────┬─────┐   ┌─────┬─────┬───┬───┬─────┐
//    │ Esc │ [ │ { │  }  │     │   │  @  │  "  │ ' │ ] │  ~  │
//    ├─────┼───┼───┼─────┼─────┤   ├─────┼─────┼───┼───┼─────┤
//    │  !  │ { │ [ │  (  │  %  │   │  #  │  -  │ = │ \ │  `  │
//    ├─────┼───┼───┼─────┼─────┤   ├─────┼─────┼───┼───┼─────┤
//    │     │ } │ ] │  )  │     │   │  &  │  _  │ + │ | │     │
//    └─────┴───┴───┼─────┼─────┤   ├─────┼─────┼───┴───┴─────┘
//                  │     │     │   │     │     │
//                  └─────┴─────┘   └─────┴─────┘
  &kp ESC    &kp LBKT   &kp LBRC   &kp RBRC   &trans          &kp AT     &kp DQT     &kp SQT     &kp RBKT   &kp TILDE
  &kp EXCL   &kp LBRC   &kp LBKT   &kp LPAR   &kp PRCNT       &kp HASH   &kp MINUS   &kp EQUAL   &kp BSLH   &kp GRAVE
  &trans     &kp RBRC   &kp RBKT   &kp RPAR   &trans          &kp AMPS   &kp UNDER   &kp PLUS    &kp PIPE   &trans
                                   &trans     &trans          &trans     &trans
            >;

        };
        nav_layer {
            display-name = "Nav Layer";
            bindings = <
//    ┌─────┬─────┬──────┬──────┬──────┐   ┌──────┬──────┬─────┬──────┬─────┐
//    │ Esc │     │ bri+ │ next │ volu │   │      │      │     │      │     │
//    ├─────┼─────┼──────┼──────┼──────┤   ├──────┼──────┼─────┼──────┼─────┤
//    │     │     │ bri- │ play │ vold │   │ left │ down │ up  │ rght │     │
//    ├─────┼─────┼──────┼──────┼──────┤   ├──────┼──────┼─────┼──────┼─────┤
//    │     │     │      │ prev │ mute │   │      │      │     │      │     │
//    └─────┴─────┴──────┼──────┼──────┤   ├──────┼──────┼─────┴──────┴─────┘
//                       │      │      │   │      │      │
//                       └──────┴──────┘   └──────┴──────┘
  &kp ESC   &trans   &kp C_BRI_UP   &kp C_NEXT   &kp C_VOL_UP       &trans     &trans     &trans   &trans      &trans
  &trans    &trans   &kp C_BRI_DN   &kp C_PP     &kp C_VOL_DN       &kp LEFT   &kp DOWN   &kp UP   &kp RIGHT   &trans
  &trans    &trans   &trans         &kp C_PREV   &kp C_MUTE         &trans     &trans     &trans   &trans      &trans
                                    &trans       &trans             &trans     &trans
            >;
        };
        tri_layer {
            display-name = "Tri Layer";
            bindings = <
//    ┌────────────┬─────┬─────┬────────┬──────────┐   ┌─────┬─────┬─────┬─────┬────────────┐
//    │ &sys_reset │     │     │        │ bt_sel 0 │   │     │     │     │     │ &sys_reset │
//    ├────────────┼─────┼─────┼────────┼──────────┤   ├─────┼─────┼─────┼─────┼────────────┤
//    │    boot    │     │     │        │ bt_sel 1 │   │     │     │     │     │    boot    │
//    ├────────────┼─────┼─────┼────────┼──────────┤   ├─────┼─────┼─────┼─────┼────────────┤
//    │            │     │     │ bt_clr │ bt_sel 2 │   │     │     │     │     │            │
//    └────────────┴─────┴─────┼────────┼──────────┤   ├─────┼─────┼─────┴─────┴────────────┘
//                             │        │          │   │     │     │
//                             └────────┴──────────┘   └─────┴─────┘
  &sys_reset    &trans   &trans   &trans       &bt BT_SEL 0       &trans   &trans   &trans   &trans   &sys_reset
  &bootloader   &trans   &trans   &trans       &bt BT_SEL 1       &trans   &trans   &trans   &trans   &bootloader
  &trans        &trans   &trans   &bt BT_CLR   &bt BT_SEL 2       &trans   &trans   &trans   &trans   &trans
                                  &trans       &trans             &trans   &trans
            >;
        };
    };
};
